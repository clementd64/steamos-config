[Unit]
Description=OpenTelemetry GPU Collector
After=network-online.target

[Service]
Type=simple
Environment=OTEL_GPU_COLLECTOR_MODE=light
Environment="OTEL_EXPORTER_OTLP_ENDPOINT={{ endpoint }}"
Environment=OTEL_EXPORTER_OTLP_PROTOCOL=grpc
Environment="OTEL_EXPORTER_OTLP_HEADERS=uptrace-dsn={{ uptrace_dsn }}"
Environment=OTEL_METRIC_EXPORT_INTERVAL=15000
ExecStart=%h/.local/bin/opentelemetry-gpu-collector
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
