{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ],
            "settings": {
                "python.terminal.activateEnvironment": false, // venv set globally
                "python.defaultInterpreterPath": "/opt/venv/bin/python"
            }
        }
    }
}